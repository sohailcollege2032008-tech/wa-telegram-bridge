# ---- Telegram (Bot API) ----
# Token of the Telegram bot created via @BotFather
TELEGRAM_BOT_TOKEN=
# Destination chat: Sohail @DrSohail_ahmed (2035706891) by default
TELEGRAM_CHAT_ID=2035706891
# Local Bot API server (supports files up to 2GB). Use https://api.telegram.org/bot for the cloud API.
TELEGRAM_API_BASE=http://127.0.0.1:8081/bot

# ---- WhatsApp ----
# Phone number in E.164 digits-only format (no +). Used to request the pairing code.
WHATSAPP_PHONE=
# Auth state directory (holds the linked-device credentials)
WHATSAPP_AUTH_DIR=/opt/wa-telegram-bridge/auth_state
# Pairing UX: "code" (enter 8-digit code on the phone) or "qr" (scan a QR image sent to Telegram)
WHATSAPP_PAIRING_MODE=code

# ---- Forwarding rules ----
# Comma-separated sender numbers (digits) or JIDs allowed to be forwarded. Empty = everyone.
ALLOWED_SENDERS=
# Forward incoming messages (messages sent TO the linked account)
FORWARD_INCOMING=true
# Forward messages sent from other devices of the linked account (including the phone itself)
FORWARD_FROM_ME=false
# Forward messages sent from another device to the account's own "Message yourself" chat
FORWARD_SELF_CHAT=true

# ---- Misc ----
LOG_LEVEL=info
# Timezone used for message timestamps in captions
TZ=Africa/Cairo
